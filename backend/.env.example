# Home Restaurant — backend environment
# Copy to .env and adjust. Never commit the real .env.

# Runtime
NODE_ENV=development          # development | test | production
PORT=4000                     # API port
HOST=0.0.0.0                  # bind address

# CORS — the frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:3000

# PostgreSQL — required (matches docker-compose.yml credentials).
# Optional only when NODE_ENV=test (unit tests that don't hit the DB).
DATABASE_URL=postgres://hr:hr@localhost:5432/home_restaurant

# Separate database used by integration tests (test:integration).
TEST_DATABASE_URL=postgres://hr:hr@localhost:5432/home_restaurant_test

# Redis — refresh-token store (matches docker-compose.yml). Required outside tests.
REDIS_URL=redis://localhost:6379

# Auth (Phase 3). JWT_SECRET signs access tokens — use a long random value in real envs.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
ACCESS_TTL_SECONDS=900       # access JWT lifetime (15 min)
REFRESH_TTL_SECONDS=604800   # refresh token lifetime (7 days)

# Payments (Phase 6) — Stripe TEST MODE keys only in development.
# Without these the app boots fine, but creating a checkout session fails with
# a clear error. Webhooks locally: `stripe listen --forward-to
# localhost:4000/api/payments/webhook` prints the whsec_… signing secret.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
SERVICE_FEE_RATE=0.10           # platform service fee (fraction of seat subtotal)
# CHECKOUT_RESULT_BASE_URL=     # base for Stripe success/cancel URLs; defaults to CORS_ORIGIN

# Rate limiting (Phase 8 hardening — docs/specs/admin.md §9). All optional;
# defaults shown. Unset RATE_LIMIT_ENABLED means "on outside NODE_ENV=test".
# RATE_LIMIT_ENABLED=true      # force on/off (true | false)
# RATE_LIMIT_GLOBAL_MAX=300    # per IP per minute, every endpoint (backstop)
# RATE_LIMIT_AUTH_MAX=10       # /api/auth/login + /api/auth/register, per IP/min
# RATE_LIMIT_REFRESH_MAX=30    # /api/auth/refresh, per IP/min
# RATE_LIMIT_ABUSE_MAX=30      # review flag + booking hold, per user/min
