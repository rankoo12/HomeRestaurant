# Home Restaurant — backend environment
# Copy to .env and adjust. Never commit the real .env.

# Runtime
NODE_ENV=development          # development | test | production
PORT=4000                     # API port
HOST=0.0.0.0                  # bind address

# CORS — the frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:3000

# PostgreSQL — required (matches docker-compose.yml credentials).
# Optional only when NODE_ENV=test (unit tests that don't hit the DB).
DATABASE_URL=postgres://hr:hr@localhost:5432/home_restaurant

# Separate database used by integration tests (test:integration).
TEST_DATABASE_URL=postgres://hr:hr@localhost:5432/home_restaurant_test

# --- Added in later phases (kept here as a forward reference) ---
# REDIS_URL=redis://localhost:6379                               # Phase 3
# JWT_SECRET=                                                    # Phase 3
# STRIPE_SECRET_KEY=                                             # Phase 6
