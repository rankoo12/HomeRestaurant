# Home Restaurant — frontend environment
# Copy to .env.local and adjust. Never commit real env files.

# Server-side base URL the API proxy forwards to (NOT exposed to the browser).
BACKEND_API_URL=http://localhost:4000

# Public site URL (exposed to the browser; must be prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps key (Maps JavaScript API + Places API). Optional: without it the
# app falls back to plain address text + an "Open in Maps" link.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
